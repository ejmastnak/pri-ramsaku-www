---
import PageWrapper from '@/shared/PageWrapper.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import FruitPanel from './partials/FruitPanel.astro'
import { Image } from 'astro:assets';
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/cultivars/apples.js';
import aboutTranslations from '@/i18n/translations/about/index.js';

import bobovecFruitImage from '@/assets/img/cultivars/apple-fruit/bobovec.jpg'
import bobovecTreeImage from '@/assets/img/cultivars/apple-trees/bobovec.jpg'
import boskopFruitImage from '@/assets/img/cultivars/apple-fruit/boskop.jpg'
import boskopTreeImage from '@/assets/img/cultivars/apple-trees/boskop.jpg'
import carjevicFruitImage from '@/assets/img/cultivars/apple-fruit/carjevic.jpg'
import carjevicTreeImage from '@/assets/img/cultivars/apple-trees/carjevic.jpg'
import grafenstajncFruitImage from '@/assets/img/cultivars/apple-fruit/grafenstajnc.jpg'
import grafenstajncTreeImage from '@/assets/img/cultivars/apple-trees/grafenstajnc.jpg'
import jagodovkaFruitImage from '@/assets/img/cultivars/apple-fruit/jagodovka.jpg'
import jagodovkaTreeImage from '@/assets/img/cultivars/apple-trees/jagodovka.jpg'
import jonatanFruitImage from '@/assets/img/cultivars/apple-fruit/jonatan.jpg'
import jonatanTreeImage from '@/assets/img/cultivars/apple-trees/jonatan.jpg'
import kanadkaFruitImage from '@/assets/img/cultivars/apple-fruit/kanadka.jpg'
import kanadkaTreeImage from '@/assets/img/cultivars/apple-trees/kanadka.jpg'
import koksovaRenetaFruitImage from '@/assets/img/cultivars/apple-fruit/koksova-reneta.jpg'
import koksovaRenetaTreeImage from '@/assets/img/cultivars/apple-trees/koksova-reneta.jpg'
import krivopeceljFruitImage from '@/assets/img/cultivars/apple-fruit/krivopecelj.jpg'
import krivopeceljTreeImage from '@/assets/img/cultivars/apple-trees/krivopecelj.jpg'
import ledrovkaFruitImage from '@/assets/img/cultivars/apple-fruit/ledrovka.jpg'
import ledrovkaTreeImage from '@/assets/img/cultivars/apple-trees/ledrovka.jpg'
import londonskiPepingFruitImage from '@/assets/img/cultivars/apple-fruit/londonski-peping.jpg'
import londonskiPepingTreeImage from '@/assets/img/cultivars/apple-trees/londonski-peping.jpg'
import mosanceljFruitImage from '@/assets/img/cultivars/apple-fruit/mosancelj.jpg'
import mosanceljTreeImage from '@/assets/img/cultivars/apple-trees/mosancelj.jpg'
import rdeciKalvilFruitImage from '@/assets/img/cultivars/apple-fruit/rdeci-kalvil.jpg'
import rdeciKalvilTreeImage from '@/assets/img/cultivars/apple-trees/rdeci-kalvil.jpg'
import sentjakobkaFruitImage from '@/assets/img/cultivars/apple-fruit/sentjakobka.jpg'
import sentjakobkaTreeImage from '@/assets/img/cultivars/apple-trees/sentjakobka.jpg'
import zlataParmenaFruitImage from '@/assets/img/cultivars/apple-fruit/zlata-parmena.jpg'
import zlataParmenaTreeImage from '@/assets/img/cultivars/apple-trees/zlata-parmena.jpg'

import boskop2FruitImage from '@/assets/img/cultivars/apple-fruit/boskop-2.jpg'
import bunkopeceljFruitImage from '@/assets/img/cultivars/apple-fruit/bunkopecelj.jpg'
import goriskaSevkaFruitImage from '@/assets/img/cultivars/apple-fruit/goriska-sevka.jpg'
import lesnikaFruitImage from '@/assets/img/cultivars/apple-fruit/lesnika.jpg'
import nagelcekFruitImage from '@/assets/img/cultivars/apple-fruit/nagelcek.jpg'
import priIzviruFruitImage from '@/assets/img/cultivars/apple-fruit/pri-izviru.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);

const breadcrumbs = [
  { routeGroupName: "about", title: aboutTranslations.h1[locale], },
  { routeGroupName: "appleCultivars", title: translations.h1[locale], },
]


const apples = {
  bobovec: {
    fruitImg: bobovecFruitImage,
    treeImg: bobovecTreeImage,
  },
  boskopskiKosmac: {
    fruitImg: boskopFruitImage,
    treeImg: boskopTreeImage,
  },
  carjevic: {
    fruitImg: carjevicFruitImage,
    treeImg: carjevicTreeImage,
  },
  grafenstajnc: {
    fruitImg: grafenstajncFruitImage,
    treeImg: grafenstajncTreeImage,
  },
  jagodovka: {
    fruitImg: jagodovkaFruitImage,
    treeImg: jagodovkaTreeImage,
  },
  jonatan: {
    fruitImg: jonatanFruitImage,
    treeImg: jonatanTreeImage,
  },
  kanadka: {
    fruitImg: kanadkaFruitImage,
    treeImg: kanadkaTreeImage,
  },
  koksovaReneta: {
    fruitImg: koksovaRenetaFruitImage,
    treeImg: koksovaRenetaTreeImage,
  },
  krivopecelj: {
    fruitImg: krivopeceljFruitImage,
    treeImg: krivopeceljTreeImage,
  },
  ledrovka: {
    fruitImg: ledrovkaFruitImage,
    treeImg: ledrovkaTreeImage,
  },
  londonskiPeping: {
    fruitImg: londonskiPepingFruitImage,
    treeImg: londonskiPepingTreeImage,
  },
  rdeciKalvil: {
    fruitImg: rdeciKalvilFruitImage,
    treeImg: rdeciKalvilTreeImage,
  },
  mosancelj: {
    fruitImg: mosanceljFruitImage,
    treeImg: mosanceljTreeImage,
  },
  sentjakobka: {
    fruitImg: sentjakobkaFruitImage,
    treeImg: sentjakobkaTreeImage,
  },
  zlataParmena: {
    fruitImg: zlataParmenaFruitImage,
    treeImg: zlataParmenaTreeImage,
  }, 
}

---

<PageWrapper>
  <h1 class="h1">{translations.h1[locale]}</h1>

  <Breadcrumbs breadcrumbs={breadcrumbs} />

  <p class="mt-10 max-w-2xl">{translations.intro[locale]}</p>

  <ul class="mt-8 space-y-8 sm:space-y-10">
    {Object.entries(apples).map(([key, value]) => (
    <li>
      <FruitPanel 
        title={translations[key].name[locale]}
        fruitImg={value.fruitImg}
        fruitImgAlt={translations[key].fruitImgAlt[locale]}
        treeImg={value.treeImg}
        treeImgAlt={translations[key].treeImgAlt[locale]}
        fruitCaption={translations[key].fruitCaption[locale]}
        treeCaption={translations[key].treeCaption[locale]}
      >
        {translations[key].description[locale]}
      </FruitPanel>
    </li>
    ))}
  </ul>

  <div class="mt-10 pt-10 border-t">
    <h2 class="text-3xl font-bold">{translations.galleryHeading[locale]}</h2>
    <p class="mt-5">
      {translations.galleryDescription[locale]}
    </p>
    <div class="mt-5 grid sm:grid-cols-12 sm:rounded-3xl gap-2 overflow-clip max-w-4xl">
      <Image src={boskop2FruitImage} alt="Boskop" class="sm:col-span-7 rounded-lg object-cover h-72" />
      <Image src={bunkopeceljFruitImage} alt="Bunkopecelj" class="sm:col-span-5 rounded-lg object-cover h-72" />
      <Image src={priIzviruFruitImage} alt="Čebulinka" class="sm:col-span-5 rounded-lg object-cover h-72" />
      <Image src={lesnikaFruitImage} alt="Lesnika" class="sm:col-span-7 rounded-lg object-cover h-72" />
      <Image src={nagelcekFruitImage} alt="Nagelček" class="sm:col-span-7 rounded-lg object-cover h-72" />
      <Image src={goriskaSevkaFruitImage} alt="Goriška sevka" class="sm:col-span-5 rounded-lg object-cover h-72" />
    </div>
  </div>

</PageWrapper>
