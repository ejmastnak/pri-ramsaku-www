---
import { Image } from 'astro:assets';
import I18nLink from '@/components/I18nLink.astro'
import I18nLinkSecondaryButton from '@/components/I18nLinkSecondaryButton.astro'
import PageWrapper from '@/shared/PageWrapper.astro'
import { extractLocaleFromRoute  } from '@/lib/routes.js';
import translations from '@/i18n/translations/about/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

const locale = extractLocaleFromRoute(Astro.url.pathname);

import carjevicImg from '@/assets/img/carjevic.jpg';
import winterDomacijaImg from '@/assets/img/winter-domacija.jpg';
import krivopeceljTreeImg from '@/assets/img/krivopecelj-tree.jpg';
import applesCrateImg from '@/assets/img/apples-crate.jpg';
import kanadkaFruitImg from '@/assets/img/varieties/apple-fruit/kanadka.jpg';
import boskopFruitImg from '@/assets/img/varieties/apple-fruit/boskop.jpg';

---

<PageWrapper>

  <h1 class="text-4xl text-center">{translations.h1[locale]}</h1>

  <p class="mt-5 max-w-xl mx-auto text-center">{translations.p1[locale]}</p>

  <div class="my-10 w-full max-w-4xl mx-auto">
    <Image src={carjevicImg} alt={imgAltTranslations.carjevicImg[locale]} class="rounded-lg h-96 mx-auto object-center object-cover" width={900} />
  </div>

  <div class="my-10 max-w-2xl mx-auto">

    <!-- Pri Ramšaku name -->
    <div>
      <h2 class="text-xl text-center font-bold">{translations.priRamsakuH2[locale]}</h2>
      <p set:html={translations.priRamsakuPHtml[locale]} class="mt-4 max-w-xl mx-auto text-center" />
    </div>

    <!-- Image grid -->
    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 place-items-center">
      <div class="hidden lg:block h-48 sm:h-52 md:h-56 rounded">
        <Image class="rounded h-full w-full object-cover" src={winterDomacijaImg} alt={imgAltTranslations.winterDomacijaImg[locale]} height={400} />
      </div>
      <div class="h-48 sm:h-52 md:h-56 rounded">
        <Image class="rounded h-full w-full object-cover" src={krivopeceljTreeImg} alt={imgAltTranslations.krivopeceljTreeImg[locale]} height={400} />
      </div>
      <div class="hidden sm:block h-48 sm:h-52 md:h-56 rounded">
        <Image class="rounded h-full w-full object-cover" src={applesCrateImg} alt={imgAltTranslations.applesCrateImg[locale]} height={400} />
      </div>
    </div>

    <!-- History -->
    <div class="mt-8">
      <h2 class="text-xl text-center font-bold">{translations.historyH2[locale]}</h2>
      <div class="mt-3 flex flex-col gap-y-2 max-w-xl mx-auto">
        <p set:html={translations.historyP1Html[locale]} />
        <p>{translations.historyP2[locale]}</p>
        <p>{translations.historyP3[locale]}</p>
      </div>
    </div>

    <div class="mt-8 grid sm:grid-cols-2 gap-4 place-items-center">
      <div class="h-48 sm:h-52 md:h-56 rounded">
        <Image class="rounded h-full w-full object-cover" src={boskopFruitImg} alt={imgAltTranslations.boskopFruitImg[locale]} height={400} />
      </div>
      <div class="h-48 sm:h-52 md:h-56 rounded">
        <Image class="rounded h-full w-full object-cover" src={kanadkaFruitImg} alt={imgAltTranslations.kanadkaFruitImg[locale]} height={400} />
      </div>
    </div>

    <!-- Focus on traditional heirloom varieties -->
    <div class="mt-8">
      <h2 class="text-xl text-center font-bold">{translations.varietiesH2[locale]}</h2>
      <div class="mt-3 space-y-2 max-w-xl mx-auto">
        <p>{translations.varietiesP1[locale]}</p>
        <p>{translations.varietiesP2[locale]}</p>
      </div>
    </div>


    <!-- Heirloom varieties -->
    <div class="mt-8">
      <h2 class="text-xl text-center font-bold">Slike starih sort</h2>
      <div class="mt-3 space-y-2 max-w-xl mx-auto">
        <p set:html={translations.varietiesP3Html[locale]}/>
      </div>
    </div>

    <!-- Heirloom varieties -->
    <div class="mt-8">
      <h2 class="text-xl text-center font-bold">Travniski sadovnjak</h2>
      <div class="mt-3 space-y-2 max-w-xl mx-auto">
        <p>{translations.varietiesP4[locale]}</p>
      </div>
    </div>


  </div>

</PageWrapper>

