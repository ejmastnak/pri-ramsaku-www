---
import { Image } from 'astro:assets';
import HeirloomVarietiesPreview from '@/shared/HeirloomVarietiesPreview.astro'
import MeadowOrchardPreview from '@/shared/MeadowOrchardPreview.astro'
import I18nLink from '@/components/I18nLink.astro'
import I18nLinkSecondaryButton from '@/components/I18nLinkSecondaryButton.astro'
import Wrapper from '@/shared/PageWrapper.astro'
import SlantedImages3 from '@/components/SlantedImages3.astro'
import translations from '@/i18n/translations/about/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import { extractLocaleFromRoute  } from '@/lib/routes.js';

const locale = extractLocaleFromRoute(Astro.url.pathname);

import carjevicImg from '@/assets/img/carjevic.jpg';

import bobovecFruitImage from '@/assets/img/varieties/apple-fruit/bobovec.jpg'
import jonatanFruitImage from '@/assets/img/varieties/apple-fruit/jonatan.jpg'
import londonskiPepingFruitImage from '@/assets/img/varieties/apple-fruit/londonski-peping.jpg'

import drobnicaFruitImage from '@/assets/img/varieties/pear-fruit/drobnica.jpg'
import hardijevaFruitImage from '@/assets/img/varieties/pear-fruit/hardijeva.jpg'
import pastorjevkaFruitImage from '@/assets/img/varieties/pear-fruit/pastorjevka.jpg'

const slantedApplesImages = {
  right: {
    image: bobovecFruitImage,
    alt: "Bobovec",
    width: 1080,
  },
  left: {
    image: jonatanFruitImage,
    alt: "Jonatan",
    width: 1080,
  },
  center: {
    image: londonskiPepingFruitImage,
    alt: "Londonski peping",
    width: 1080,
  },
}

const slantedPearImages = {
  center: {
    image: drobnicaFruitImage,
    alt: "Drobnica",
    width: 1080,
  },
  left: {
    image: hardijevaFruitImage,
    alt: "Hardijeva",
    width: 1080,
  },
  right: {
    image: pastorjevkaFruitImage,
    alt: "Pastorjevka",
    width: 1080,
  },
}

---

<Wrapper>

  <h1 class="h1 text-center">{translations.h1[locale]}</h1>

  <p class="mt-5 max-w-xl mx-auto text-center">{translations.intro[locale]}</p>

  <div class="my-10 w-full max-w-4xl mx-auto">
    <Image src={carjevicImg} alt={imgAltTranslations.carjevicImg[locale]} class="rounded-lg h-96 mx-auto object-center object-cover" width={900} />
  </div>

  <!-- Pri Ramšaku name -->
  <div class="mt-10">
    <h2 class="text-xl text-center font-bold">{translations.priRamsakuHeading[locale]}</h2>
    <p set:html={translations.priRamsakuBodyHtml[locale]} class="mt-4 max-w-xl mx-auto text-center" />
  </div>

</Wrapper>

<SlantedImages3 images={slantedApplesImages} className="max-w-7xl mx-auto my-8" responsive={true} />

<Wrapper>

  <!-- History -->
  <div>
    <h2 class="text-xl text-center font-bold">{translations.historyHeading[locale]}</h2>
    <div class="mt-3 flex flex-col gap-y-2 max-w-xl mx-auto">
      <p set:html={translations.historyP1Html[locale]} />
      <p>{translations.historyP2[locale]}</p>
      <p>{translations.historyP3[locale]}</p>
    </div>
  </div>
</Wrapper>

<SlantedImages3 images={slantedPearImages} className="max-w-7xl mx-auto my-8" responsive={true} />

<Wrapper>

  <!-- Focus on traditional heirloom varieties -->
  <section class="mt-8">
    <h2 class="text-xl text-center font-bold">{translations.varietiesHeading[locale]}</h2>
    <div class="mt-3 space-y-2 max-w-xl mx-auto">
      <p>{translations.varietiesP1[locale]}</p>
      <p>{translations.varietiesP2[locale]}</p>
    </div>
  </section>

  <!-- Heirloom varieties -->
  <section class="mt-8">
    <h2 class="text-xl text-center font-bold">{translations.picturesHeading[locale]}</h2>
    <div class="mt-3">
      <p class="max-w-xl mx-auto" set:html={translations.picturesParagraph[locale]}/>
      <div class="mt-5">
        <HeirloomVarietiesPreview />
      </div>
    </div>
  </section>

  <!-- Heirloom varieties -->
  <section class="mt-8">
    <h2 class="text-xl text-center font-bold">{translations.meadowOrchardHeading[locale]}</h2>
    <p class="mt-3 space-y-2 max-w-xl mx-auto">{translations.meadowOrchardParagraph[locale]}</p>
    <MeadowOrchardPreview />
  </section>

</Wrapper>
