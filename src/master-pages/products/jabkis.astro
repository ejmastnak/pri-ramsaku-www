---
import { Image } from 'astro:assets';
import I18nLink from '@/components/I18nLink.astro'
import PageWrapper from '@/shared/PageWrapper.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PriceList from '@/components/PriceList.astro'
import HowToBuyButton from '@/components/HowToBuyButton.astro'
import Bio from '@/shared/Bio.astro'
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/products/jabkis.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import { jabkis as products } from '@/assets/data/products.js'

import jabkisImg from '@/assets/img/jabkis.jpg'
import applesCrateImg from '@/assets/img/apples-crate.jpg'
import cisternsImg from '@/assets/img/cisterns.jpg'
import presaBarrelImg from '@/assets/img/presa-barrel-landscape.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);

const breadcrumbs = [
  { routeGroupName: "products", title: "Products", },
  { routeGroupName: "jabkis", title: "Apple Cider Vinegar", },
]

---

<PageWrapper>
  <div class="max-w-4xl mx-auto">

    <div class="w-full flex items-start pr-2">
      <h1 class="text-4xl">{translations.h1[locale]}</h1>
      <HowToBuyButton classes="hidden sm:inline-flex" />  
    </div>
    <Breadcrumbs classes="mt-1" breadcrumbs={breadcrumbs} />

    <!-- Panel 1 -->
    <div class="mt-10 md:flex md:flex-row-reverse gap-x-8">
      <Image
        src={jabkisImg}
        alt={imgAltTranslations.jabkisImg[locale]}
        class="shrink-0 w-full mx-auto max-w-sm md:max-w-80 lg:max-w-96 max-h-72 object-cover rounded-md"
      />
      <div class="mt-5 md:mt-2 text-gray-800">
        <p>{translations.p1[locale]}</p>
        <p class="mt-2">{translations.p2[locale]}</p>
      </div>
    </div>

    <Bio classes="mt-5 md:mt-16 max-w-xl" />

    <!-- Panel 2 -->
    <div class="mt-5 md:mt-16 md:flex gap-x-8">
      <Image
        src={applesCrateImg}
        alt={imgAltTranslations.applesCrateImg[locale]}
        class="shrink-0 w-full mx-auto max-w-sm md:max-w-80 lg:max-w-96 max-h-72 object-cover rounded-md"
      />
      <div class="mt-5 md:mt-2 text-gray-800">
        <p set:html={translations.p2html[locale]}></p>
        <p class="mt-2">{translations.p3[locale]}</p>
      </div>
    </div>

    <!-- Panel 3 -->
    <div class="mt-5 md:mt-16 md:flex md:flex-row-reverse gap-x-8">
      <Image
        src={presaBarrelImg}
        alt={imgAltTranslations.presaBarrelImg[locale]}
        class="shrink-0 w-full h-56 mx-auto md:w-80 md:h-80 lg:w-96 lg:h-96 object-cover rounded-md"
      />
      <div class="mt-5 md:mt-2 text-gray-800">
        <p>{translations.p4[locale]}</p>
      </div>
    </div>

    <p class="my-5 md:my-10 max-w-xl">{translations.p5[locale]}</p>

    <!-- Panel 4 -->
    <div class="mt-5 md:mt-16 md:flex gap-x-8">
      <Image
        src={cisternsImg}
        alt={imgAltTranslations.cisternsImg[locale]}
        class="shrink-0 w-full mx-auto max-w-sm md:max-w-80 lg:max-w-96 max-h-72 object-cover rounded-md"
      />
      <div class="mt-5 md:mt-2 text-gray-800">{translations.p6[locale]}</div>
    </div>

    <PriceList classes="mt-10" products={products} />
    <p class="mt-2 max-w-lg">
      <span set:html={translations.buyToOrderHtml[locale]}/>
      <I18nLink routeGroupName="contact" classes="text-blue-500 hover:text-blue-600 hover:underline">{translations.contact[locale]}</I18nLink>
    </p>
    

  </div>
</PageWrapper>
