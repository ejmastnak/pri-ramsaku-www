---
import PageWrapper from '@/shared/PageWrapper.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/products/jabkis.js';

const breadcrumbs = [
  { routeGroupName: "products", title: "Products", },
  { routeGroupName: "jabkis", title: "Apple Cider Vinegar", },
]

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<PageWrapper>
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl text-center">Apple Cider Vinegar</h1>

    <p class="mt-2 mx-auto text-center max-w-sm text-sm text-gray-600 italic">
      Some descriptions of our apple cider vinegar.
    </p>

    <Breadcrumbs breadcrumbs={breadcrumbs} />

  </div>
</PageWrapper>
