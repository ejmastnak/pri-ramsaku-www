---
import { Image } from 'astro:assets';
import PageWrapper from '@/shared/PageWrapper.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import ShoppingCart from 'astro-heroicons/outline/ShoppingCart.astro';
import I18nLink from '@/components/I18nLink.astro'
import Bio from '@/shared/Bio.astro'
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/products/other.js';
import productsTranslations from '@/i18n/translations/products/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import winterDomacijaImg from '@/assets/img/winter-domacija.jpg';
import krivopeceljTreeImg from '@/assets/img/krivopecelj-tree.jpg';
import applesCrateImg from '@/assets/img/apples-crate.jpg';

const locale = extractLocaleFromRoute(Astro.url.pathname);

const breadcrumbs = [
  { routeGroupName: "products", title: productsTranslations.h1[locale], },
  { routeGroupName: "otherProducts", title: translations.h1[locale], },
]

---

<PageWrapper>
  <div class="max-w-4xl mx-auto">

    <h1 class="h1">{translations.h1[locale]}</h1>
    <Breadcrumbs className="mx-auto" breadcrumbs={breadcrumbs} />

    <div class="mt-5 md:mt-8 max-w-xl">
      <p class="mx-auto">{translations.p1[locale]}</p>

      <p class="my-5">
        {translations.p2[locale]}
        <I18nLink routeGroupName="contact" className="text-orange-950 underline hover:text-orange-900">{translations.contact[locale]}</I18nLink>
      </p>

    </div>

  </div>
</PageWrapper>
