---
import { Image } from 'astro:assets';
import PageWrapper from '@/shared/PageWrapper.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import ShoppingCart from 'astro-heroicons/outline/ShoppingCart.astro';
import I18nLink from '@/components/I18nLink.astro'
import Bio from '@/shared/Bio.astro'
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/products/other.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import winterDomacijaImg from '@/assets/img/winter-domacija.jpg';
import krivopeceljTreeImg from '@/assets/img/krivopecelj-tree.jpg';
import applesCrateImg from '@/assets/img/apples-crate.jpg';

const locale = extractLocaleFromRoute(Astro.url.pathname);

const breadcrumbs = [
  { routeGroupName: "products", title: "Products", },
  { routeGroupName: "otherProducts", title: "Other products", },
]

---

<PageWrapper>
  <div class="max-w-4xl mx-auto">

    <h1 class="text-4xl text-center">{translations.h1[locale]}</h1>
    <Breadcrumbs classes="text-center mx-auto" breadcrumbs={breadcrumbs} />

    <div class="mt-5 md:mt-8">
      <p class="max-w-xl mx-auto text-center">{translations.p1[locale]}</p>

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 place-items-center">
        <div class="hidden lg:block h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={winterDomacijaImg} alt={imgAltTranslations.winterDomacijaImg[locale]} height={400} />
        </div>
        <div class="h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={krivopeceljTreeImg} alt={imgAltTranslations.krivopeceljTreeImg[locale]} height={400} />
        </div>
        <div class="hidden sm:block h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={applesCrateImg} alt={imgAltTranslations.applesCrateImg[locale]} height={400} />
        </div>
      </div>

      <p class="my-12 max-w-lg mx-auto text-center">
        {translations.p2[locale]}
        <I18nLink routeGroupName="contact" classes="text-blue-500 hover:text-blue-600 hover:underline">{translations.contact[locale]}</I18nLink>
      </p>

    </div>

  </div>
</PageWrapper>
