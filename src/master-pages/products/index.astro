---
import { Image } from 'astro:assets';
import I18nLink from '@/components/I18nLink.astro'
import PageWrapper from '@/shared/PageWrapper.astro'
import BentoCard from '@/components/BentoCard.astro'
import BentoWrapper from '@/components/BentoWrapper.astro'
import HowToBuyButton from '@/components/HowToBuyButton.astro'
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/products/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import jabsokImg from '@/assets/img/jabsok.jpg';
import jabkisImg from '@/assets/img/jabkis.jpg';
import sntoljImg from '@/assets/img/sntolj.jpg'
import applesCrateImg from '@/assets/img/apples-crate.jpg';

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<PageWrapper>
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl text-center">{translations.h1[locale]}</h1>

    <p class="mt-2 mx-auto text-center max-w-sm text-sm text-gray-600 italic">{translations.p1[locale]}</p>

    <HowToBuyButton classes="mt-5" />

    <BentoWrapper classes="my-10 gap-x-8 gap-y-12 grid-cols-1 lg:grid-cols-2">

      <I18nLink routeGroupName="jabsok">
        <BentoCard title={translations.jabsokTitle[locale]} img={jabsokImg} imgAlt={imgAltTranslations.jabsokImg[locale]}>
          {translations.jabsokDescription[locale]}
        </BentoCard>
      </I18nLink>

      <I18nLink routeGroupName="jabkis">
        <BentoCard title={translations.jabkisTitle[locale]} img={jabkisImg} imgAlt={imgAltTranslations.jabkisImg[locale]}>
          {translations.jabkisDescription[locale]}
        </BentoCard>
      </I18nLink>

      <I18nLink routeGroupName="sntolj">
        <BentoCard title={translations.sntoljTitle[locale]} img={sntoljImg} imgAlt={imgAltTranslations.sntoljImg[locale]}>
          {translations.sntoljDescription[locale]}
        </BentoCard>
      </I18nLink>

      <I18nLink routeGroupName="otherProducts">
        <BentoCard title={translations.otherTitle[locale]} img={applesCrateImg} imgAlt={imgAltTranslations.applesCrateImg[locale]}>
          {translations.otherDescription[locale]}
        </BentoCard>
      </I18nLink>

    </BentoWrapper>

  </div>
</PageWrapper>
