---
import { Image } from 'astro:assets';

import I18nLink from '@/components/I18nLink.astro'
import { extractLocaleFromRoute  } from '@/lib/routes.js';
import translations from '@/i18n/translations/home/hero.js';
import apples3Image from '@/assets/img/apples3.png'

const locale = extractLocaleFromRoute(Astro.url.pathname);

---

<div class="bg-red-900 pb-10 py-5 md:py-8 lg:py-12 px-6 sm:px-12 md:px-20 md:h-[420px] xl:h-[475px]">

  <div class="max-w-3xl mx-auto text-white flex gap-x-2">

    <div>
      <p class="text-xl sm:text-2xl ml-1 font-bold ">Kmetija <span class="sm:hidden">pri</span></p>
      <p class="text-5xl xs:text-6xl -translate-y-1 text-nowrap"><span class="hidden sm:inline">Pri</span> Ramšaku</p>

      <div class="mt-2">
        <p class="max-w-xs md:max-w-sm text-gray-50 py-1">
          {translations.text[locale]}
        </p>
        <I18nLink className="mt-2 inline-block text-sm italic hover:underline" routeGroupName="about">
          {translations.more[locale]}
          <span aria-hidden="true"> &rarr;</span>
        </I18nLink>
      </div>
    </div>

    <div class="hidden xs:block shrink-0 ml-auto self-end md:translate-y-5 lg:translate-y-10">
      <Image src={apples3Image} alt={"Logo of three apples"} class="w-24 sm:w-28 md:w-32 lg:w-36"/>
    </div>

  </div>


</div>


