---
import { Image } from 'astro:assets';
import Hero from './partials/Hero.astro'
import HeirloomVarietiesPreview from '@/shared/HeirloomVarietiesPreview.astro'
import I18nLink from '@/components/I18nLink.astro'
import I18nLinkButton from '@/components/I18nLinkButton.astro'
import Wrapper from '@/shared/Wrapper.astro'
import { extractLocaleFromRoute  } from '@/lib/routes.js';
import translations from '@/i18n/translations/home/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';
const locale = extractLocaleFromRoute(Astro.url.pathname);

import SlantedImages3 from '@/components/SlantedImages3.astro'

import winterDomacijaImg from '@/assets/img/winter-domacija.jpg';
import krivopeceljTreeImg from '@/assets/img/krivopecelj-tree.jpg';
import applesCrateImg from '@/assets/img/apples-crate.jpg';
import jabsokImg from '@/assets/img/jabsok.jpg';
import jabkisImg from '@/assets/img/jabkis.jpg';

import boskopFruitImage from '@/assets/img/varieties/apple-fruit/boskop.jpg'
import kanadkaFruitImage from '@/assets/img/varieties/apple-fruit/kanadka.jpg'
import krivopeceljFruitImage from '@/assets/img/varieties/apple-fruit/krivopecelj.jpg'

const slantedApplesImages = {
  left: {
    image: boskopFruitImage,
    alt: "Boskopski kosmač",
    width: 1080,
  },
  center: {
    image: kanadkaFruitImage,
    alt: "Kanadka",
    width: 1080,
  },
  right: {
    image: krivopeceljFruitImage,
    alt: "Krivopeclj",
    width: 1080,
  },
}

const slantedAboutImages = {
  right: {
    image: winterDomacijaImg,
    alt: imgAltTranslations.winterDomacijaImg[locale],
    width: 1080,
  },
  left: {
    image: krivopeceljTreeImg,
    alt: imgAltTranslations.krivopeceljTreeImg[locale],
    width: 1080,
  },
  center: {
    image: applesCrateImg,
    alt: imgAltTranslations.applesCrateImg[locale],
    width: 1080,
  },
}

---

<div class="mx-auto">

  <Hero class="w-screen" />

  <SlantedImages3 images={slantedApplesImages} className="mt-8 sm:mt-16 lg:mt-20 xl:mt-24 max-w-7xl mx-auto" />

  <Wrapper className="sm:mt-8 lg:mt-12 py-6 md:py-8">

    <!-- HeirloomVarieties -->
    <section class="text-center">
      <h2 class="text-xl font-bold">{translations.varietiesHeading[locale]}</h2>
      <p class="mt-3 max-w-xl mx-auto ">{translations.varietiesBody[locale]}</p>
      <div class="mt-8">
        <HeirloomVarietiesPreview />
      </div>
    </section>

    <!-- Products -->
    <section class="mt-16 pt-12 border-t border-gray-200 text-center">

      <h2 class="text-xl font-bold">{translations.productsH2[locale]}</h2>
      <p class="mt-3 max-w-xl mx-auto ">{translations.productsP[locale]}</p>

      <div class="mt-6 grid sm:grid-cols-2 gap-8 place-items-center max-w-2xl mx-auto">
        <div class="h-60 rounded">
          <Image class="rounded h-full w-full object-cover" src={jabsokImg} alt={imgAltTranslations.jabsokImg[locale]} height={400} />
        </div>
        <div class="hidden sm:block h-60 rounded">
          <Image class="rounded h-full w-full object-cover" src={jabkisImg} alt={imgAltTranslations.jabkisImg[locale]} height={400} />
        </div>
      </div>

      <I18nLinkButton className="mt-6" routeGroupName="products">{translations.productsLink[locale]}</I18nLinkButton>

    </section>

  </Wrapper>

  <!-- About -->
  <section class="mt-12 pt-12 border-t border-gray-200 text-center max-w-7xl mx-auto px-5">

    <h2 class="text-xl font-bold">{translations.aboutHeading[locale]}</h2>

    <p class="mt-3 max-w-xl mx-auto">{translations.aboutBody1[locale]}</p>  

    <SlantedImages3 images={slantedAboutImages} className="my-12" responsive={true} />

    <p class="max-w-xl mx-auto text-center">{translations.aboutBody2[locale]}</p>

    <I18nLinkButton className="mt-6" routeGroupName="about">{translations.aboutLink[locale]}</I18nLinkButton>

  </section>

  <!-- Links -->
  <Wrapper className="mb-32">
    <section class="mt-12 pt-12 border-t border-gray-200 max-w-xl mx-auto">
      <h2 class="text-xl text-center font-bold">{translations.linksH2[locale]}</h2>
      <ul class="mt-2 text-left list-disc ml-5 space-y-2">
        <li><I18nLink routeGroupName="varieties" className="text-orange-950 font-medium hover:text-orange-700 underline">{translations.varietiesLink[locale]}</I18nLink></li>
          <li><I18nLink routeGroupName="meadowOrchard" className="text-orange-950 font-medium hover:text-orange-700 underline">{translations.meadowOrchardLink[locale]}</I18nLink></li>
            <li><I18nLink routeGroupName="about" className="text-orange-950 font-medium hover:text-orange-700 underline">{translations.aboutLink2[locale]}</I18nLink></li>
      </ul>
    </section>
  </Wrapper>

</div>
