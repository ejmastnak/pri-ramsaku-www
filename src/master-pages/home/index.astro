---
import Hero from './partials/Hero.astro'
import I18nLink from '@/components/I18nLink.astro'
import translations from '@/i18n/translations/home.js';
import { extractLocaleFromRoute  } from '@/i18n/translation.js';

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<div class="mx-auto">

  <Hero class="w-screen" />

  <h1 class="text-5xl">{translations.h1[locale]}</h1>

  <div class="mt-8">
    <I18nLink classes="text-blue-500 hover:text-blue-600 hover:underline" routeGroupName="about">
      {translations.link[locale]}
    </I18nLink>
  </div>

</div>

