---
import { Image } from 'astro:assets';
import Hero from './partials/Hero.astro'
import I18nLink from '@/components/I18nLink.astro'
import I18nLinkButton from '@/components/I18nLinkButton.astro'
import Wrapper from '@/shared/Wrapper.astro'
import { extractLocaleFromRoute  } from '@/lib/routes.js';
import translations from '@/i18n/translations/home/index.js';

const locale = extractLocaleFromRoute(Astro.url.pathname);

import winterDomacijaImg from '@/assets/img/winter-domacija.jpg';
import krivopeceljTreeImg from '@/assets/img/krivopecelj-tree.jpg';
import applesCrateImg from '@/assets/img/apples-crate.jpg';
import jabsokImg from '@/assets/img/jabsok.jpg';
import jabkisImg from '@/assets/img/jabkis.jpg';

---

<div class="mx-auto">

  <Hero class="w-screen" />

  <Wrapper classes="py-6 md:py-8">

    <div>
      <p class="max-w-xl mx-auto text-center italic">
        {translations.p1[locale]}
      </p>  

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 place-items-center">
        <div class="hidden lg:block h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={winterDomacijaImg} alt="Foo" height={400} />
        </div>
        <div class="h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={krivopeceljTreeImg} alt="Foo" height={400} />
        </div>
        <div class="hidden sm:block h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={applesCrateImg} alt="Foo" height={400} />
        </div>
      </div>

      <p class="my-12 max-w-xl mx-auto text-center italic">
        {translations.p2[locale]}
      </p>
    </div>

    <!-- Products -->
    <div class="border-t border-gray-100 my-10 pt-10 max-w-2xl mx-auto text-center">
      <h2 class="text-xl text-center font-bold">{translations.productsH2[locale]}</h2>
      <p class="mt-2 max-w-md mx-auto">
        {translations.productsP[locale]}
      </p>

      <I18nLinkButton routeGroupName="products" classes="my-5">{translations.productsLink[locale]}</I18nLinkButton>

      <div class="mt-2 grid sm:grid-cols-2 gap-8 place-items-center">
        <div class="h-48 sm:h-60 rounded">
          <Image class="rounded h-full w-full object-cover" src={jabsokImg} alt="Foo" height={400} />
        </div>
        <div class="hidden sm:block h-48 sm:h-60 rounded">
          <Image class="rounded h-full w-full object-cover" src={jabkisImg} alt="Foo" height={400} />
        </div>
      </div>
    </div>

    <!-- Links -->
    <div class="mt-12 pt-8 border-t border-gray-100 max-w-xl mx-auto">
      <h2 class="text-xl text-center font-bold">{translations.linksH2[locale]}</h2>
      <ul class="mt-2 text-left list-disc ml-5">
        <li>the heirloom <I18nLink routeGroupName="varieties" classes="text-blue-500 hover:text-blue-600 hover:underline">APPLE AND PEAR VARIETIES</I18nLink> on our farm</li>
        <li>the <I18nLink routeGroupName="meadowOrchard" classes="text-blue-500 hover:text-blue-600 hover:underline">TALL-TRUNK MEADOW ORCHARD HABITAT</I18nLink> on our farm</li>
        <li>our FARM'S HISTORY</li>
      </ul>
    </div>

  </Wrapper>
</div>

