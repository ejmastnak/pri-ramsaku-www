---
import { Image } from 'astro:assets';
import Hero from './partials/Hero.astro'
import HeirloomVarietiesPreview from '@/shared/HeirloomVarietiesPreview.astro'
import I18nLink from '@/components/I18nLink.astro'
import I18nLinkButton from '@/components/I18nLinkButton.astro'
import Wrapper from '@/shared/Wrapper.astro'
import { extractLocaleFromRoute  } from '@/lib/routes.js';
import translations from '@/i18n/translations/home/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';
const locale = extractLocaleFromRoute(Astro.url.pathname);

import winterDomacijaImg from '@/assets/img/winter-domacija.jpg';
import krivopeceljTreeImg from '@/assets/img/krivopecelj-tree.jpg';
import applesCrateImg from '@/assets/img/apples-crate.jpg';
import jabsokImg from '@/assets/img/jabsok.jpg';
import jabkisImg from '@/assets/img/jabkis.jpg';

---

<div class="mx-auto">

  <Hero class="w-screen" />

  <Wrapper classes="py-6 md:py-8">

    <!-- Products -->
    <div class="mt-12 max-w-2xl mx-auto text-center">

      <div class="mt-2 grid sm:grid-cols-2 gap-8 place-items-center">
        <div class="h-48 sm:h-60 rounded">
          <Image class="rounded h-full w-full object-cover" src={jabsokImg} alt={imgAltTranslations.jabsokImg[locale]} height={400} />
        </div>
        <div class="hidden sm:block h-48 sm:h-60 rounded">
          <Image class="rounded h-full w-full object-cover" src={jabkisImg} alt={imgAltTranslations.jabkisImg[locale]} height={400} />
        </div>
      </div>

      <p class="my-5 max-w-md mx-auto">
        {translations.productsP[locale]}
      </p>

      <I18nLinkButton routeGroupName="products">{translations.productsLink[locale]}</I18nLinkButton>

    </div>

    <!-- HeirloomVarieties -->
    <section class="mt-20 text-center">
      <h2 class="text-xl font-bold">{translations.varietiesHeading[locale]}</h2>
      <p class="mt-3 max-w-xl mx-auto ">{translations.varietiesBody[locale]}</p>
      <div class="mt-5">
        <HeirloomVarietiesPreview />
      </div>
    </section>

    <!-- About farm -->
    <section class="mt-16 text-center">

      <h2 class="text-xl font-bold">{translations.aboutHeading[locale]}</h2>

      <p class="mt-3 max-w-xl mx-auto">{translations.aboutBody1[locale]}</p>  

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 place-items-center">
        <div class="hidden lg:block h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={winterDomacijaImg} alt={imgAltTranslations.winterDomacijaImg[locale]} height={400} />
        </div>
        <div class="h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={krivopeceljTreeImg} alt={imgAltTranslations.krivopeceljTreeImg[locale]} height={400} />
        </div>
        <div class="hidden sm:block h-48 sm:h-52 md:h-56 rounded">
          <Image class="rounded h-full w-full object-cover" src={applesCrateImg} alt={imgAltTranslations.applesCrateImg[locale]} height={400} />
        </div>
      </div>

      <p class="my-12 max-w-xl mx-auto text-center">{translations.aboutBody2[locale]}</p>

    </section>

    <!-- Links -->
    <div class="mt-12 border-t border-gray-100 max-w-xl mx-auto">
      <h2 class="text-xl text-center font-bold">{translations.linksH2[locale]}</h2>
      <ul class="mt-2 text-left list-disc ml-5">
        <li><I18nLink routeGroupName="varieties" classes="text-orange-950 font-medium hover:text-orange-700 hover:underline">{translations.varietiesLink[locale]}</I18nLink></li>
        <li><I18nLink routeGroupName="meadowOrchard" classes="text-orange-950 font-medium hover:text-orange-700 hover:underline">{translations.meadowOrchardLink[locale]}</I18nLink></li>
        <li><I18nLink routeGroupName="about" classes="text-orange-950 font-medium hover:text-orange-700 hover:underline">{translations.aboutLink[locale]}</I18nLink></li>
      </ul>
    </div>

  </Wrapper>
</div>

