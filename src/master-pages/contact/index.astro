---
import { Image } from 'astro:assets';
import PageWrapper from '@/shared/PageWrapper.astro'
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/index/contact.js';
import appleBlossomsImg from '@/assets/img/slive-blossoms.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<PageWrapper>
  <h1 class="text-5xl">Contact</h1>

  <p class="mt-8">
    You can contact us by:
  </p>

  <div class="mt-5 flex flex-col lg:flex-row gap-y-10 gap-x-16 lg:-mr-12">
    <div class="max-w-sm">
      <ul class="mt-3 flex flex-col gap-y-2 ml-5 list-disc">
        <li>
          Phone or WhatsApp at <a class="inline font-bold text-gray-800 hover:text-blue-600" href="tel:+38631230167">+386 31 230 167</a>
          <br>(call or SMS, whichever you prefer)
        </li>
        <li>
          Email at <a class="inline font-bold text-gray-800 hover:text-blue-600" href="mailto:info@gaia.si">info@gaia.si</a>
        </li>
      </ul>

      <p class="mt-5">
        Smo majhna kmetija in smo veseli osebnega kontakta.
        Z veseljem sodelujemo pri naročilih, uskladimo dostavo čim se le da in odgovorimo na morebitna vprašanje.
      </p>

    </div>

    <div class="h-80 rounded">
      <Image src={appleBlossomsImg} alt="Apple blossoms" class="rounded h-full w-full max-w-xl mx-auto  object-cover" width={600} />
    </div>

  </div>

  <!-- <p class="max-w-2xl"> -->
  <!--     Contact us to order products, arrange delivery, visit our farm, or ask questions. -->
  <!--   </p> -->


</PageWrapper>


