---
import { Image } from 'astro:assets';
import PageWrapper from '@/shared/PageWrapper.astro'
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/contact/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';
import sliveBlossomsImg from '@/assets/img/slive-blossoms.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);

---

<PageWrapper>
  <h1 class="h1">{translations.h1[locale]}</h1>

  <div class="mt-8 flex flex-col lg:flex-row gap-y-10 gap-x-12 lg:-mr-12">
    <div class="max-w-md">

      <p>{translations.p1[locale]}</p>

      <ul class="mt-3 flex flex-col gap-y-2 ml-5 list-disc">
        <li>
          {translations.phone1[locale]} <a class="inline font-bold text-gray-800 hover:text-orange-900" href="tel:+38631230167">+386 31 230 167</a>
          <br>{translations.phone2[locale]}
        </li>
        <li>
          {translations.email[locale]} <a class="inline font-bold text-gray-800 hover:text-orange-900" href="mailto:priramsaku@ejmastnak.com">priramsaku@ejmastnak.com</a>
        </li>
      </ul>

      <p class="mt-5">{translations.p2[locale]}</p>

    </div>

    <Image src={sliveBlossomsImg} alt={imgAltTranslations.sliveBlossomsImg[locale]} class="rounded w-full max-w-lg mx-auto object-cover" width={600} />

  </div>

</PageWrapper>
