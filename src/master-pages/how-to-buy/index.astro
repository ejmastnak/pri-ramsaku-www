---
import { Image } from 'astro:assets';
import PageWrapper from '@/shared/PageWrapper.astro'
import ArrowTopRightOnSquare from 'astro-heroicons/outline/ArrowTopRightOnSquare.astro';
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import I18nLink from '@/components/I18nLink.astro'
import PrimaryLink from '@/components/PrimaryLink.astro'
import translations from '@/i18n/translations/how-to-buy/index.js';

import orehTreeImg from '@/assets/img/oreh-tree.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<PageWrapper>

  <h1 class="text-5xl">How to buy</h1>

  <!-- -mr moves image rightward -->
  <div class="mt-10 lg:flex space-x-16 lg:-mr-12">
    <div class="max-w-sm">

      <!-- Contact us directly to order -->
      <div>
        <p class="font-bold">Option 1: Contact us directly</p>
        <p class="mt-1">
          You can order products by
          <I18nLink classes="text-blue-500 hover:text-blue-600 hover:underline" routeGroupName="contact">contacting us directly by email or phone</I18nLink>
          We are happy to arrange delivery and other details with our customers on a case-by-case basis.
        </p>
      </div>

      <!-- E-shop -->
      <div class="mt-5">
        <p class="font-bold">Option 2: Use our online shop</p>
        <p class="">If you prefer, you can also easily order products on our online shop:</p>
        <div class="mt-3">
          <PrimaryLink classes="inline-flex items-center gap-x-1.5" href="https://shop.gaia.si">
            <span>Our online shop</span>
            <ArrowTopRightOnSquare class="size-5 text-white shrink-0" />
          </PrimaryLink>
        </div>
      </div>

    </div>

    <Image
      src={orehTreeImg}
      alt="orehTreeImg"
      class="hidden lg:block mx-auto !w-96 h-80 object-cover rounded-md"
    />

  </div>

  <!-- Delivery -->
  <div class="mt-8 max-w-2xl">
    <h2 class="text-2xl">Delivery</h2>
    <p class="mt-1">We can deliver to Ljubljana and locally to the greater Mislinja region. If you are located elsewhere in Slovenia and are interested in our products, we may be able to arrange delivery for larger orders—contact us for details.</p>
  </div>


</PageWrapper>
