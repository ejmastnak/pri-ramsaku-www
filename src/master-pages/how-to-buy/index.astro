---
import { Image } from 'astro:assets';
import PageWrapper from '@/shared/PageWrapper.astro'
import ArrowTopRightOnSquare from 'astro-heroicons/outline/ArrowTopRightOnSquare.astro';
import { extractLocaleFromRoute, } from '@/lib/routes.js';
import I18nLink from '@/components/I18nLink.astro'
import PrimaryLink from '@/components/PrimaryLink.astro'
import translations from '@/i18n/translations/how-to-buy/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import orehTreeImg from '@/assets/img/oreh-tree.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<PageWrapper>

  <h1 class="text-5xl">{translations.h1[locale]}</h1>

  <!-- -mr moves image rightward -->
  <div class="mt-10 lg:flex space-x-16 lg:-mr-12">
    <div class="max-w-sm flex flex-col gap-y-5">

      <!-- E-shop -->
      <div>
        <p class="font-bold">{translations.orderByWebshop[locale]}</p>
        <p>{translations.webshop[locale]}</p>
        <div class="mt-3">
          <PrimaryLink classes="inline-flex items-center gap-x-1.5" href="https://shop.gaia.si">
            <span>{translations.webshopLink[locale]}</span>
            <ArrowTopRightOnSquare class="size-5 text-white shrink-0" />
          </PrimaryLink>
        </div>
      </div>

      <!-- Contact us directly to order -->
      <div>
        <p class="font-bold">{translations.orderByContact[locale]}</p>
        <p class="mt-1">
          {translations.phone1[locale]} <a class="inline font-bold text-gray-800 hover:text-blue-600" href="tel:+38631230167">+386 31 230 167</a> {translations.phone2[locale]} {translations.email[locale]} <a class="inline font-bold text-gray-800 hover:text-blue-600" href="mailto:priramsaku@ejmastnak.com">priramsaku@ejmastnak.com</a>.
          {translations.details[locale]}
        </p>
      </div>

    </div>

    <Image
      src={orehTreeImg}
      alt={imgAltTranslations.orehTreeImg[locale]}
      class="hidden lg:block mx-auto !w-96 h-80 object-cover rounded-md"
    />

  </div>

  <!-- Delivery -->
  <div class="mt-8 max-w-xl">
    <h2 class="text-2xl">{translations.deliveryH2[locale]}</h2>
    <p class="mt-1">{translations.deliveryP[locale]}</p>
  </div>


</PageWrapper>
