---
import I18nLink from '@/components/I18nLink.astro'
import PageWrapper from '@/shared/PageWrapper.astro'
import BentoCard from '@/components/BentoCard.astro'
import BentoWrapper from '@/components/BentoWrapper.astro'

import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/meadow-orchard/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import dandelionsImg from '@/assets/img/dandelions.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<PageWrapper>
  <div class="max-w-4xl mx-auto text-center">
    <BentoWrapper classes="gap-x-8 gap-y-12 grid-cols-1 mx-auto max-w-md">
      <I18nLink routeGroupName="meadowOrchard">
        <BentoCard classes="hover:shadow-md hover:outline hover:outline-1 hover:outline-gray-200" title={translations.h1[locale]} img={dandelionsImg} imgAlt={imgAltTranslations.dandelionsImg[locale]}>
        </BentoCard>
      </I18nLink>
    </BentoWrapper>
  </div>
</PageWrapper>
