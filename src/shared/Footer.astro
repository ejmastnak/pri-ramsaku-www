---
import { Image } from 'astro:assets';
import { extractLocaleFromRoute, } from '@/lib/routes.js';

import apples3Image from '@/assets/img/apples3.png'

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<div class="clip-wave-top-condensed sm:clip-wave-top bg-red-900 text-white pt-16 pb-8 sm:pb-24 sm:relative">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row gap-y-5 px-4 sm:px-8">

    <div>
      <p class="text-2xl sm:text-3xl">Kmetija</p>
      <p class="text-4xl sm:text-5xl">Pri Ramšaku</p>
      <div class="mt-8">
        <p>Tolsti Vrh pri Mislinji 47</p>
        <p>2382 Mislinja, Slovenija</p>
      </div>
      <div class="mt-6 border-t border-gray-400 w-fit">
        <a class="mt-3 block" href="mailto:priramsaku@ejmastnak.com">
          priramsaku@ejmastnak.com
        </a>
        <a class="flex items-center" href="tel:+38631230167">
          <p class="text-sm font-bold">+</p>
          <p>386 31 230 167</p>
        </a>
      </div>
    </div>

    <div class="shrink-0 sm:ml-auto sm:self-end">
      <Image src={apples3Image} alt={"Logo of three apples"} class="w-24 sm:w-28 md:w-32 opacity-85"/>
    </div>

  </div>

  <div class="mt-16 sm:mt-0 sm:left-1/2 sm:-translate-x-1/2 w-full max-w-5xl px-4 sm:px-8 text-red-100 text-sm sm:absolute sm:bottom-4">
    {locale == 'en' ? 'Website and photography: Elijan Mastnak' : 'Izdelava in fotografije: Elijan Mastnak' }
  </div>

</div>



