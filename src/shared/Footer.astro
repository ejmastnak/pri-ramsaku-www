---
import I18nFooterLink from '@/components/I18nFooterLink.astro'
import translations from '@/i18n/translations/shared/footer.js';
import { extractLocaleFromRoute } from '@/lib/routes.js';
const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<div class="clip-wave-top-condensed sm:clip-wave-top bg-red-900 text-white px-4 pt-16 pb-24 text-lg">
  <div class="max-w-5xl mx-auto flex">

    <!-- Gaia d.o.o. info -->
    <div class="ml-4">
      <p class="text-5xl font-serif">Pri Ramšaku</p>
      <div class="mt-8">
        <p>Center Gaia d.o.o.</p>
        <p>Tolsti Vrh pri Mislinji 47</p>
        <p>2382 Mislinja, Slovenija</p>
      </div>
      <div class="mt-6 border-t border-gray-400 w-fit">
        <a class="mt-3 block" href="mailto:info@gaia.si">
          info@gaia.si
        </a>
        <a class="flex items-center" href="tel:+38631230167">
          <p class="text-sm font-bold">+</p>
          <p>386 31 230 167</p>
        </a>
      </div>
    </div>

    <!-- Links -->
    <ul class="hidden lg:flex ml-auto mt-3 justify-around space-x-12 h-fit">
      <li><I18nFooterLink routeGroupName="home">{translations.home[locale]}</I18nFooterLink></li>
      <li><I18nFooterLink routeGroupName="about">{translations.about[locale]}</I18nFooterLink></li>
      <li><I18nFooterLink routeGroupName="products">{translations.products[locale]}</I18nFooterLink></li>
    </ul>

  </div>
</div>



