---
import I18nLink from '@/components/I18nLink.astro'
import BentoCard from '@/components/BentoCard.astro'
import BentoWrapper from '@/components/BentoWrapper.astro'

import { extractLocaleFromRoute, } from '@/lib/routes.js';
import translations from '@/i18n/translations/cultivars/index.js';
import imgAltTranslations from '@/i18n/translations/shared/imgAlts.js';

import boskopFruitImg from '@/assets/img/cultivars/apple-fruit/boskop.jpg'
import hardijevaFruitImg from '@/assets/img/cultivars/pear-fruit/hardijeva.jpg'

const locale = extractLocaleFromRoute(Astro.url.pathname);
---

<div class="max-w-4xl mx-auto text-center">
  <BentoWrapper className="gap-x-8 gap-y-12 grid-cols-1 lg:grid-cols-2">
    <I18nLink routeGroupName="appleCultivars">
      <BentoCard className="hover:shadow-md hover:outline hover:outline-1 hover:outline-gray-200" title={translations.applesH2[locale]} img={boskopFruitImg} imgAlt={imgAltTranslations.boskopFruitImg[locale]}>
        {translations.applesP1[locale]}
      </BentoCard>
    </I18nLink>

    <I18nLink routeGroupName="pearCultivars">
      <BentoCard className="hover:shadow-md hover:outline hover:outline-1 hover:outline-gray-200" title={translations.pearsH2[locale]} img={hardijevaFruitImg} imgAlt={imgAltTranslations.hardijevaFruitImg[locale]}>
        {translations.pearsP1[locale]}
      </BentoCard>
    </I18nLink>
  </BentoWrapper>
</div>

