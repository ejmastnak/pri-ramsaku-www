<!-- Used to put a wavey clip path at the bottom of a div -->
<svg width="0" height="0">
  <defs>
    <clipPath id="clipWave" clipPathUnits="objectBoundingBox">
      <path d="
        M 0,0
        L 0,0.9
        C 0.15,1  0.25,1  0.43,0.95
        S 0.83,0.90 1,0.95
        L 1,0
        Z
        " />
    </clipPath>
  </defs>
</svg>

<style is:global>
.clip-wave {
  clip-path: url(#clipWave);
}
</style>
