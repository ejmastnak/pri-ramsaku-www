---
import { explicitRoutesForAmbiguousRoute } from '@/lib/routes.js';
import { LOCALE_NAMES } from "@/i18n/config";

const options = explicitRoutesForAmbiguousRoute(Astro.url.pathname)
---

<div>
  <p>Choose a language:</p>
  <ul>
    {Object.entries(options).map(([locale, route]) => (
    <li>
      <a href={route} class="block text-blue-500 hover:underline hover:text-blue-600">
        { LOCALE_NAMES[locale] }
      </a>
    </li>
    ))}
  </ul>
</div>
