---
import { extractLocaleFromRoute, getExplicitRoute, routeToGroupName } from '@/lib/routes.js';
import { LOCALES, LOCALE_NAMES, } from "@/i18n/config"

import GlobeAlt from 'astro-heroicons/outline/GlobeAlt.astro';
import ChevronDown from 'astro-heroicons/outline/ChevronDown.astro';

// Construct { "en": "en/about", "sl": "sl/o-nas", }
const routes = Object.fromEntries(
  LOCALES.map(locale => [locale, getExplicitRoute(routeToGroupName(Astro.url.pathname), locale)])
);

const currentLocale = extractLocaleFromRoute(Astro.url.pathname);
---

<!-- Fallback if JS is not supported: plain links to explicit-route page  -->
<noscript>
  <ul id="locale-switcher-fallback" class="flex gap-x-2" data-locale-switcher>
    {Object.entries(routes).map(([locale, route]) => (
    <li>
      <a href={route} class={`text-blue-500 hover:underline hover:text-blue-500 ${(locale === currentLocale) ? "font-semibold" : ""}`}>{locale}</a>
    </li>
    ))}
  </ul>
</noscript>

<div id="locale-switcher-js" class="js-only">
  <el-dropdown class="inline-block">
    <button class="inline-flex items-center justify-center gap-x-1.5 rounded-md bg-orange-50 px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:shadow-sm hover:ring-orange-700">
      <div class="inline-flex items-center gap-x-1 rounded-l-md text-white">
        <GlobeAlt class="-ml-0.5 size-5 text-gray-600" />
        <p class="text-sm font-semibold text-gray-700 w-4">{currentLocale}</p>
      </div>
      <span class="sr-only">Change language</span>
      <ChevronDown class="size-5 translate-y-px" aria-hidden="true" />
    </button>

    <el-menu anchor="bottom end" popover class="m-0 w-40 origin-top-right rounded-md bg-orange-50 p-0 shadow-lg outline outline-1 outline-black/5 transition [--anchor-gap:theme(spacing.2)] [transition-behavior:allow-discrete] data-[closed]:scale-95 data-[closed]:transform data-[closed]:opacity-0 data-[enter]:duration-100 data-[leave]:duration-75 data-[enter]:ease-out data-[leave]:ease-in">
      <div>
        <ul class="flex flex-col divide-y divide-gray-200" data-locale-switcher>
          {Object.entries(routes).map(([locale, route]) => (
          <li>
            <button
              id={`locale-switcher-button-${locale}`}
              type="button"
              class={`flex w-full justify-between hover:underline px-4 py-4 ${locale === currentLocale ? 'bg-orange-100 font-semibold' : ""}`}
              data-locale={locale}
              data-route={route}
              data-current={locale === currentLocale}
              aria-current={locale === currentLocale ? "true" : undefined}
            >
              { LOCALE_NAMES[locale] }
            </button>
          </li>
          ))}
        </ul>

      </div>
    </el-menu>
  </el-dropdown>
</div>


<script>
document.querySelector("ul[data-locale-switcher]")?.addEventListener("click", (e) => {
  const button = e.target.closest("button[data-locale]");
  if (!button) return;
  window.localStorage.setItem("user-locale", button.dataset.locale);
  if (button.dataset.current !== "true") {
    window.location.href = button.dataset.route;
  }
});
</script>
