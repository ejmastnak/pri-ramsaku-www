---
import { extractLocaleFromRoute, getExplicitRoute, normalizeRoute } from "@/lib/routes.js";

interface Props {
  routeGroupName: string,
};
const { routeGroupName, } = Astro.props as Props;

const locale = extractLocaleFromRoute(Astro.url.pathname);
const route = getExplicitRoute(routeGroupName, locale);
const currentRoute = normalizeRoute(Astro.url.pathname);

let className = "hover:underline hover:text-blue-600"
if (route === currentRoute) className += " font-medium";
---

<a href={route} class={className} >
  <slot/>
</a>
