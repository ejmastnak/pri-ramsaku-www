---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  img: {src: string};
  imgAlt: string;
  classes?: string;
}
const { title, img, imgAlt, classes } = Astro.props as Props;
---


<div class="relative">
  <div class={`relative flex h-full flex-col overflow-hidden rounded-lg ${classes ?? ""}`}>
    <Image src={img} alt={imgAlt} width={800} class="shrink-0 w-full mx-auto max-w-md h-80 object-cover rounded-md" />
    <div class="px-4 pb-6 pt-2">
      <p class="mt-2 text-lg font-bold tracking-tight text-gray-950">{title}</p>
      <div class="mt-2 max-w-lg text-sm/6 text-gray-600">
        <slot />
      </div>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-0 rounded-lg shadow outline outline-1 outline-black/5"></div>
</div>
