---
import { extractLocaleFromRoute, getExplicitRoute } from "@/i18n/translation.js";

interface Props {
  routeGroupKey: string,
};
const { routeGroupKey, } = Astro.props as Props;

const locale = extractLocaleFromRoute(Astro.url.pathname);
const route = getExplicitRoute(routeGroupKey, locale);
const currentRoute = Astro.url.pathname;

let classes = "hover:underline hover:text-blue-600"
if (route === currentRoute) classes += " font-medium";
---

<a href={route} class={classes} >
  <slot/>
</a>
