---
import "@/assets/css/tailwind.css";
import "@/assets/css/fonts.css";
import Nav from '@/shared/Nav.astro'
import Footer from '@/shared/Footer.astro'
import Redirect from '@/shared/Redirect.astro'
import ClipPaths from '@/shared/ClipPaths.astro'

interface Props {
  locale: string,
  head: { title: string, description: string },
  ambiguousLocale?: boolean
}
const { locale, head, ambiguousLocale = false } = Astro.props as Props;
---
<html lang={locale} class="no-js">
  <head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={head.description[locale]} />
    <title>{head.title[locale]} | Pri Ramšaku</title>

    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="manifest" href="/favicon/site.webmanifest">

    { ambiguousLocale && <Redirect /> }

    <script src="/src/lib/elements.js"></script>

    <script>
    document.documentElement.classList.replace('no-js', 'js');
    </script>

    {import.meta.env.PROD && (
    <style is:global>
    .no-js .js-only { display: none; }
    </style>
    )}

  </head>

  <body class="bg-orange-50">
    { !ambiguousLocale && <Nav />}
    <main class="mx-auto">
      <slot />
    </main>
    { !ambiguousLocale && <Footer />}

    <ClipPaths />
  </body>

</html>
